// Static site served by a Cloudflare Worker (assets only, no script).
// Build first: `npm run build`, then `npx wrangler deploy`.
{
	"name": "pdf-garrettholmes",
	"compatibility_date": "2026-11-01",
	"assets": {
		"directory": "./build",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page"
	},
	"workers_dev": false,
	"routes": [{ "pattern": "pdf.garrettholmes.com", "custom_domain": true }],
	"preview_urls": false
}
