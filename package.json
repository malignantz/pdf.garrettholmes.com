{
	"name": "pdf.garrettholmes.com",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/csp-headers.mjs && node scripts/precache-list.mjs",
		"preview": "node scripts/serve-build.mjs",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"icons": "node scripts/make-icons.mjs",
		"survey:profile": "node --experimental-transform-types --no-warnings --import ./tools/survey/register.mjs tools/survey/survey.ts profile",
		"survey:sample": "node --experimental-transform-types --no-warnings --import ./tools/survey/register.mjs tools/survey/survey.ts sample",
		"survey:run": "node --experimental-transform-types --no-warnings --import ./tools/survey/register.mjs tools/survey/survey.ts run",
		"survey:report": "node --experimental-transform-types --no-warnings --import ./tools/survey/register.mjs tools/survey/survey.ts report",
		"forms:measure": "node --experimental-transform-types --no-warnings --import ./tools/survey/register.mjs tools/forms-detect/measure.ts",
		"forms:snap": "node --experimental-transform-types --no-warnings --import ./tools/survey/register.mjs tools/forms-snap/measure.ts",
		"hltext:measure": "node --experimental-transform-types --no-warnings --import ./tools/survey/register.mjs tools/hl-text/measure.ts",
		"ocr:setup": "npm --prefix tools/ocr ci --no-audit --no-fund && sh tools/ocr/fetch-models.sh",
		"ocr:measure": "node --experimental-transform-types --no-warnings --import ./tools/survey/register.mjs tools/ocr/measure.ts",
		"ocr:scans": "node --experimental-transform-types --no-warnings --import ./tools/survey/register.mjs tools/ocr/scans.ts",
		"ocr:browser": "node --experimental-transform-types --no-warnings --import ./tools/survey/register.mjs tools/ocr/browser/bench.ts",
		"ocr:grade": "node --experimental-transform-types --no-warnings --import ./tools/survey/register.mjs tools/ocr/grade.ts",
		"ocr:osd": "node --experimental-transform-types --no-warnings --import ./tools/survey/register.mjs tools/ocr/osd.ts",
		"ocr:gate": "node --experimental-transform-types --no-warnings --import ./tools/survey/register.mjs tools/ocr/gate.ts"
	},
	"devDependencies": {
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^22.20.5",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@cantoo/fontkit": "^2.0.12",
		"@cantoo/pdf-lib": "^2.11.1",
		"@neslinesli93/qpdf-wasm": "^0.3.1",
		"fflate": "^0.8.2",
		"mupdf": "^1.28.6",
		"pdfjs-dist": "^6.5.438",
		"tesseract.js": "7.0.0",
		"tesseract.js-core": "7.0.0"
	},
	"license": "AGPL-3.0-or-later"
}
