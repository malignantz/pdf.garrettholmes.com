{
	"name": "pdf.garrettholmes.com",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/csp-headers.mjs && node scripts/precache-list.mjs",
		"preview": "node scripts/serve-build.mjs",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"icons": "node scripts/make-icons.mjs"
	},
	"devDependencies": {
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^22.20.5",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@cantoo/fontkit": "^2.0.12",
		"@cantoo/pdf-lib": "^2.11.1",
		"@neslinesli93/qpdf-wasm": "^0.3.1",
		"mupdf": "^1.28.6",
		"pdfjs-dist": "^6.5.438"
	},
	"license": "AGPL-3.0-or-later"
}
