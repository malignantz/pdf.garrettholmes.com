# Cloudflare Pages response headers.
# The CSP placeholder below is replaced at build time by scripts/csp-headers.mjs with the policy
# SvelteKit wrote into the pages (including its inline-script hashes) plus
# header-only directives. Do not edit the policy here; edit cspDirectives in vite.config.ts.
# no-transform keeps Cloudflare from rewriting pages (it would inject its analytics script).

/*
  Content-Security-Policy: __CSP__
  Referrer-Policy: no-referrer
  Cache-Control: public, max-age=0, must-revalidate, no-transform
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: accelerometer=(), autoplay=(), browsing-topics=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), hid=(), magnetometer=(), microphone=(), midi=(), payment=(), publickey-credentials-get=(), serial=(), usb=(), xr-spatial-tracking=()

/_app/immutable/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable, no-transform

/service-worker.js
  ! Cache-Control
  Cache-Control: no-cache, no-transform

/manifest.webmanifest
  Content-Type: application/manifest+json
  ! Cache-Control
  Cache-Control: no-cache, no-transform
